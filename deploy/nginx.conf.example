server {
    listen 80;
    server_name global-fund-next.213.199.40.67.sslip.io;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name global-fund-next.213.199.40.67.sslip.io;

    # Provision these certificates with the host's existing ACME/certificate setup.
    ssl_certificate     /etc/letsencrypt/live/global-fund-next.213.199.40.67.sslip.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/global-fund-next.213.199.40.67.sslip.io/privkey.pem;

    location /socket.io/ {
        proxy_pass http://127.0.0.1:3101/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
    }

    location / {
        proxy_pass http://127.0.0.1:3101;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
