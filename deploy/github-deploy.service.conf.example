# Install as /etc/systemd/system/global-fund-next.service.d/github-deploy.conf.
# The original EnvironmentFile and writable runtime directory remain configured.
[Service]
WorkingDirectory=/home/codex/deployments/global-fund-next/current
ExecStartPre=
ExecStartPre=/usr/local/bin/node /home/codex/deployments/global-fund-next/current/node_modules/tsx/dist/cli.mjs apps/server/src/migrate.ts
ExecStart=
ExecStart=/usr/local/bin/node /home/codex/deployments/global-fund-next/current/node_modules/tsx/dist/cli.mjs apps/server/src/index.ts
